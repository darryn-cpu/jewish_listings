# Local `npx supabase start` prints the API URL, database URL, and service role key.
# Hosted projects: use the transaction pooler (port 6543) for DATABASE_URL
# and the session pooler or direct connection (port 5432) for DIRECT_URL.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Example hosted DATABASE_URL:
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET="business-documents"

# At least 32 characters. Never expose this to the browser.
JWT_SECRET="replace-with-a-random-string-at-least-32-chars"

ADMIN_SEED_EMAIL="reviewer@foundation2000.org.za"
ADMIN_SEED_PASSWORD="replace-with-a-long-password"

APP_URL="http://localhost:3000"
MAIL_FROM="Jewish Business Directory <onboarding@example.com>"
RESEND_API_KEY=""

# Leave both blank in local development to skip the bot check.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
